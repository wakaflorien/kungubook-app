{
  "name": "kungubook-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "tsx scripts/tokens.ts && prettier --write src/theme/tokens.ts",
    "api:sync": "tsx scripts/api-sync.ts",
    "mock": "tsx scripts/mock-server.ts",
    "doctor": "expo-doctor",
    "mock:prism": "prism mock src/api/openapi.yaml --port 4010 --host 0.0.0.0",
    "api:insomnia": "tsx scripts/insomnia.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/material-symbols-rounded": "^0.4.66",
    "@expo/ui": "~58.0.29",
    "@noble/hashes": "^2.4.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@tanstack/react-query": "^5.108.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "uuidv7": "^1.2.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.16.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "msw": "^3.0.7",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "sf-symbols-typescript": "2.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
